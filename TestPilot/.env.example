# TestPilot — environment template. Copy to `.env` and fill in.
# NEVER commit .env (it holds real tokens). This .example is safe to commit.
# Every var is read server-side only (Vite dev middleware) — never bundled to
# the client. Any connector with no token degrades gracefully to sample data.

# --- Asana (QA queue from Asana tasks) ---
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=            # optional

# --- GitHub (issues → tasks, PR views, repo-issue close) ---
GITHUB_TOKEN=                  # a PAT with repo scope for your org
GITHUB_REPO=                   # optional default, e.g. awesomemotive/pushengage-sdks

# --- Slack (QA hand-offs from a channel) ---
SLACK_BOT_TOKEN=
SLACK_QA_CHANNEL=qa-automation # optional (defaults to qa-automation)

# --- Anthropic (Manual Test "Ask AI" + AI QA authoring + SKB compose) ---
# Provide ONE of these, OR run `ant auth login` (uses that profile, no key here).
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# --- SKB Docs (create Heroic KB drafts on skb.pushengage.com) ---
# Create a WP Application Password at skb → Profile → Application Passwords.
SKB_WP_USER=
SKB_WP_APP_PASSWORD=

# --- Test Runner ---
# Path to the folder holding the Playwright suites (TestPilot's siblings).
# Leave unset to auto-resolve to the repo root (the parent of TestPilot/).
QA_ROOT=
PORT=5173                      # optional (dev server port)
