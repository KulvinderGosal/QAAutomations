# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env / secrets (Asana token, etc.)
.env

# Runner runtime state — run history, schedules, and per-run story detail files.
# Written to the project root at runtime; watch-ignored in vite.config.ts.
.testpilot-*.json

# Playwright MCP / CLI scratch dumps — regenerated tooling output, never app code.
.playwright-mcp/
.playwright-cli/

# Loose QA output artifacts (screenshots / zips) saved to the project root.
# Real assets live in public/ or src/, so root-level ones are always scratch.
/*.png
/*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
