# QA Automation Environment Variables
# Copy this file to .env and fill in actual values

# Default Environment (staging or local)
TEST_ENV=staging

# STAGING WordPress Credentials
WP_ADMIN_URL=https://qastaging.pushengage.com/admin
WP_USERNAME=kgosal
WP_PASSWORD=!letmeIn@123=

# LOCAL WordPress Credentials
LOCAL_WP_ADMIN_URL=http://productionautomation.local/wp-admin
LOCAL_WP_USERNAME=admin
LOCAL_WP_PASSWORD=admin@123=

# Plugin Info
PLUGIN_NAME=PushEngage
PLUGIN_SEARCH_TERM=pushengage

# Test Environment
TEST_TIMEOUT=30000
HEADLESS=true
BROWSER=chromium

# Report Settings
REPORT_PATH=./test-results
SCREENSHOT_PATH=./screenshots
VIDEO_PATH=./videos

# =====================================================
# AI Onboarding Wizard suite (tests/onboarding-wizard)
# ============================================================
# App dashboard under test (the wizard lives here)
APP_DASHBOARD_URL=https://staging-app-dashboard2.pushengage.com

# Owner accounts (do NOT commit real secrets — keep these in your local .env only)
# Account A = Free plan admin owner; Account B = Business or higher admin owner
PE_ACCOUNT_A_EMAIL=
PE_ACCOUNT_A_PASSWORD=
PE_ACCOUNT_B_EMAIL=
PE_ACCOUNT_B_PASSWORD=
PE_ACCOUNT_B_PLAN=business
# Non-admin sub-user on account B (for 403 cases)
PE_SUBUSER_EMAIL=
PE_SUBUSER_PASSWORD=
# Shopify-connected account (per-site Shopify gate cases)
PE_SHOPIFY_EMAIL=
PE_SHOPIFY_PASSWORD=

# Site fixtures — id is the PushEngage site id, url is the site's public URL
# site1: live https + PushEngage installed correctly (WordPress if possible)
PE_SITE_1_ID=
PE_SITE_1_URL=
PE_SITE_1_NAME=
# site2: live https, NO PushEngage code
PE_SITE_2_ID=
PE_SITE_2_URL=
PE_SITE_2_NAME=
# site3: PushEngage installed under a DIFFERENT site key (foreign install)
PE_SITE_3_ID=
PE_SITE_3_URL=
PE_SITE_3_NAME=
# site4: created BEFORE 2026-08-05 with an http:// site_url
PE_SITE_4_ID=
PE_SITE_4_URL=
PE_SITE_4_NAME=
# site5: created ON/AFTER 2026-08-05 with an http:// site_url
PE_SITE_5_ID=
PE_SITE_5_URL=
PE_SITE_5_NAME=

# Mobile fixtures (App Push track + Settings > Installation > Mobile)
PE_ANDROID_SA_JSON_PATH=
PE_ANDROID_SENDER_ID=
PE_IOS_P12_PATH=
PE_IOS_P12_PASSWORD=
PE_IOS_P12_EXPIRED_PATH=
PE_PLAY_PACKAGE=com.whatsapp
PE_APPSTORE_URL=

# Backend direct-API cases (groups M / N / O)
PE_BACKEND_URL=
PE_ADMIN_TOKEN=

# Optional timeout overrides (ms)
PE_ACTION_TIMEOUT=15000
PE_NAV_TIMEOUT=30000
PE_ANALYZING_TIMEOUT=25000
=======
# TypeSafe Jev (System One) decision model
# Get an API key at https://typesafe.ai — leave TYPESAFE_API_KEY blank to skip Jev-based tests.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=typesafe/jev
# Minimum confidence (0..1) before an AI answer is treated as decisive
JEV_MIN_CONFIDENCE=0.7
JEV_TIMEOUT=10000

# Claude (Anthropic API) — "System Two" fallback behind Jev.
# Get an API key at https://console.anthropic.com — leave ANTHROPIC_API_KEY blank to skip Claude tests.
ANTHROPIC_API_KEY=
# Default is the most capable model; switch to e.g. claude-haiku-4-5 for cheaper, high-volume runs.
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT=60000

# =====================================================
# PushEngage MCP QA (tests/pushengage-mcp, PR #287) — see tests/pushengage-mcp/README.md
# =====================================================
# How to start the MCP build under test (stdio). Args: space-separated, or a JSON array.
PE_MCP_COMMAND=
PE_MCP_ARGS=
# Plus whatever env var the MCP server reads its API key from, e.g. PUSHENGAGE_API_KEY= (TEST site only)
# 1 = really send pushes. Anything else = dry run (send tools blocked, filters still checked).
PE_MCP_ALLOW_SEND=
# Claude drives the MCP; needs ANTHROPIC_API_KEY (above) or an `ant auth login` profile.
PE_MCP_MODEL=claude-opus-5-5
PE_MCP_EFFORT=medium
# off = drop the server-side refusal fallback (use if your SDK/account rejects it)
PE_MCP_FALLBACKS=
# Optional overrides when tool auto-detection picks the wrong tool
PE_MCP_LIST_TOOL=
PE_MCP_GET_TOOL=
# Test-site fixtures
PE_MCP_SEGMENT_1=
PE_MCP_SEGMENT_2=
PE_MCP_PAUSED_SEGMENT=
PE_MCP_MISSPELLED_SEGMENT=
PE_MCP_ATTRIBUTE_NAME=
PE_MCP_ATTRIBUTE_VALUE=
PE_MCP_COUNTRY_1=
PE_MCP_COUNTRY_2=
PE_MCP_MISSPELLED_COUNTRY=
PE_MCP_DEVICE=mobile
PE_MCP_BROWSER=Chrome
PE_MCP_AUDIENCE_GROUP=
PE_MCP_NOTIFICATION_URL=
