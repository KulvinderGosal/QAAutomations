{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../../TestPilot/node_modules/@types"],
    "paths": {
      "@playwright/test": ["../../TestPilot/node_modules/@playwright/test"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
